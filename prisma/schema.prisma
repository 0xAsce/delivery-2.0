generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  SELLER
  CUSTOMER
}

enum StoreStatus {
  OPEN
  BUSY
  CLOSED
  VACATION
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String?   @unique
  emailVerified    DateTime?
  phone            String?   @unique
  phoneVerifiedAt  DateTime?
  image            String?
  password         String?
  wilaya           String?
  city             String?
  address          String?
  role             UserRole  @default(CUSTOMER)
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?

  accounts         Account[]
  sessions         Session[]
  sellerSessions   SellerSession[]
  customerSessions CustomerSession[]
  customerOrders   CustomerOrder[]

 store Store?

mainStoreId String?
mainStore   Store? @relation("CustomerMainStore", fields: [mainStoreId], references: [id], onDelete: SetNull)

@@index([mainStoreId])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([wilaya])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SellerSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expires   DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CustomerSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expires   DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Store {
  id             String      @id @default(cuid())
  name           String
  description    String?     @db.Text
  logo           String?     @db.Text
  banner         String?     @db.Text
  address        String?
  latitude       Float?
  longitude      Float?
  phone          String?
  email          String?
  deliveryRadius Float?
  openingHours   Json?
  taxInformation Json?
  status         StoreStatus @default(CLOSED)
  balance        Decimal     @default(0)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  mainCustomers User[] @relation("CustomerMainStore")

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum StockMovementType {
  RESTOCK
  SALE
  ADJUSTMENT
  RETURN
  DAMAGED
  TRANSFER
}

enum CustomerOrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum CustomerPaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

model CustomerOrder {
  id         String  @id @default(cuid())
  customerId String
  shopId     String?

  name           String?
  phone          String?
  email          String?
  wilaya         String?
  city           String?
  address        String?
  deliveryMethod String?

  status        CustomerOrderStatus   @default(PENDING)
  paymentStatus CustomerPaymentStatus @default(UNPAID)

  total Decimal @db.Decimal(10, 2)
  note  String? @db.Text

  customer User                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CustomerOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([shopId])
  @@index([status])
  @@index([createdAt])
}

model CustomerOrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?

  name     String
  unit     String?
  price    Decimal @db.Decimal(10, 2)
  quantity Int

  order CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String? @db.Text
  image       String?
  isActive    Boolean @default(true)
  parentId    String?

  parent        Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  subcategories Category[] @relation("CategoryTree")
  products      Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

model Product {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String? @db.Text

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  costPrice     Decimal  @default(0) @db.Decimal(10, 2)
  sellingPrice  Decimal  @default(0) @db.Decimal(10, 2)
  discountPrice Decimal? @db.Decimal(10, 2)

  isHidden   Boolean @default(false)
  isFeatured Boolean @default(false)

  images   ProductImage[]
  variants ProductVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
  @@index([categoryId])
  @@index([isHidden])
  @@index([isFeatured])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url       String  @db.Text
  altText   String?
  isPrimary Boolean @default(false)
  position  Int     @default(0)

  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductVariant {
  id        String @id @default(cuid())
  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku            String   @unique
  barcode        String?  @unique
  size           String?
  color          String?
  weight         Decimal? @db.Decimal(10, 3)
  costPrice      Decimal? @db.Decimal(10, 2)
  sellingPrice   Decimal? @db.Decimal(10, 2)
  discountPrice  Decimal? @db.Decimal(10, 2)
  stockQuantity  Int      @default(0)
  lowStockAlert  Int      @default(5)
  trackInventory Boolean  @default(true)
  isActive       Boolean  @default(true)

  stockMovements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model StockMovement {
  id        String @id @default(cuid())
  variantId String

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  type      StockMovementType
  quantity  Int
  reason    String?
  reference String?

  createdAt DateTime @default(now())

  @@index([variantId])
}
